{
  "_comment": "Columns event-source writes (transferSale). The same file is committed in the event-source repo. orders and order_items are inserted by the indexer, so any NOT NULL column without a default must be listed; products is only updated. batch_id and draw_outcome are written by S5a-es, only for batch offers. actions/validators: setactgroup (R2.1) updates actions and deletes validators by action_id.",
  "orders": {
    "insert": true,
    "columns": {
      "product_id": "bigint",
      "from_id": "character varying",
      "to_id": "character varying",
      "amount": "double precision",
      "units": "integer",
      "community_id": "character varying",
      "status": "character varying",
      "origin": "character varying",
      "total_token": "numeric",
      "created_block": "integer",
      "created_tx": "character varying",
      "created_at": "timestamp without time zone",
      "created_eos_account": "character varying",
      "inserted_at": "timestamp without time zone",
      "updated_at": "timestamp without time zone"
    }
  },
  "order_items": {
    "insert": true,
    "columns": {
      "order_id": "bigint",
      "product_id": "bigint",
      "batch_id": "bigint",
      "quantity": "integer",
      "unit_price_token": "numeric",
      "title_snapshot": "character varying",
      "draw_outcome": "character varying",
      "inserted_at": "timestamp without time zone",
      "updated_at": "timestamp without time zone"
    }
  },
  "products": {
    "insert": false,
    "columns": {
      "units": "integer"
    }
  },
  "actions": {
    "insert": false,
    "columns": {
      "validator_role": "character varying",
      "validator_role_seq": "bigint",
      "validator_role_block": "integer",
      "last_tx": "character varying",
      "last_eos_account": "character varying"
    }
  },
  "validators": {
    "insert": false,
    "columns": {
      "action_id": "bigint"
    }
  }
}
